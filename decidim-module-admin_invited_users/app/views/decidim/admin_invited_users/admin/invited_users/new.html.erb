<%= decidim_form_for(@form, url: decidim_admin_invited_users.invited_users_path, html: { class: "form" }) do |f| %>
  <div class="card">
    <div class="card-divider">
      <h2 class="card-title"><%= t(".title") %></h2>
    </div>

    <div class="card-section">
      <div class="row column">
        <%= f.text_field :name, autofocus: true %>
      </div>

      <div class="row column">
        <%= f.email_field :email %>
      </div>
    </div>
  </div>

  <div class="button--double form-general-submit">
    <%= f.submit t(".send_invitation"), class: "button" %>
    <%= link_to t("actions.cancel", scope: "decidim.admin"), decidim_admin.officializations_path, class: "button hollow" %>
  </div>
<% end %>
